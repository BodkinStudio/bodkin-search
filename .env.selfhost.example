# Bodkin Search Cloudflare self-host. Walkthrough: docs/SELF_HOSTING_CLOUDFLARE_ALCHEMY.md

# ---------- Required ----------

# Get one at https://dataforseo.com — see docs/DATAFORSEO_API_KEY.md
DATAFORSEO_API_KEY=

# Who may sign in through Cloudflare Access, comma-separated
ACCESS_ALLOWED_EMAILS=

# ---------- Optional — uncomment to use ----------

# Journey analytics on a selfhost custom hostname. Opens ONLY the tracker
# asset and browser collector paths; dashboard and server integrations stay gated.
# ANALYTICS_PUBLIC_INGESTION=true
# Generate four independent secrets of at least 32 random characters.
# Store securely and preserve across redeploys; never rotate the erasure key casually.
# ANALYTICS_NETWORK_HMAC_SECRET=
# ANALYTICS_IDENTITY_ASSERTION_SECRET=
# ANALYTICS_SERVER_EVENT_SECRET=
# ANALYTICS_ERASURE_HMAC_SECRET=
# Explicit trusted Access user IDs for analytics administration (not email addresses).
# ANALYTICS_ADMIN_USER_IDS=
# Optional permitted outbound lifecycle webhook hostnames.
# ANALYTICS_WEBHOOK_HOSTS=

# Google Search Console (all three together) — docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=
# LinkedIn Page analytics stays disabled until Community Management access is granted.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_PAGE_ANALYTICS_ENABLED=true

# SAM, the in-app agent (hidden if unset)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Your own PostHog product analytics
# POSTHOG_PUBLIC_KEY=
# POSTHOG_HOST=

# Opt out of anonymized telemetry — docs/SELF_HOSTING_CLOUDFLARE_OPERATIONS.md
# OPENSEO_TELEMETRY_DISABLED=1

# Bring your own Cloudflare Access application instead of the auto-provisioned
# one (ACCESS_ALLOWED_EMAILS is then ignored)
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-access-application-audience-tag
